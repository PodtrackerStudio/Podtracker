// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── ENUMS ──────────────────────────────────────────────

// The 5-tier rating scale from the landing page's "Ratings explained" section.
// DIDNT_FINISH is excluded from average-rating math per that same section.
enum RatingTier {
  HIGHLY_RECOMMEND
  RECOMMEND
  OK
  DONT_RECOMMEND
  DIDNT_FINISH
}

enum PersonRole {
  HOST
  GUEST
}

// ── USERS & SOCIAL GRAPH ───────────────────────────────

// The profile half of an account. Supabase Auth owns the credential half —
// email, password and sessions all live in Supabase's own `auth.users`, which
// this schema does not describe and Prisma never touches.
//
// `id` is the Supabase user's UUID, written here at signup rather than
// generated. No default: a row with a made-up id would belong to nobody, since
// `getCurrentUser` looks users up by the id Supabase reports. That id is the
// foreign key for all ten relations below, so it must be the same value on both
// sides or the whole graph detaches.
model User {
  id           String   @id
  username     String   @unique
  email        String   @unique
  displayName  String
  avatarUrl    String?
  bio          String? // short bio shown under avatar on profile
  longBio      String? // longer bio shown top-right on profile
  externalLink String? // e.g. "Youtube.com" link on profile
  createdAt    DateTime @default(now())

  // Personal theme — what the site looks like for this person only. Null means
  // Sasha's default. Validated in src/lib/theme.ts: colours are #rrggbb, the
  // font is one of THEME_FONTS' keys.
  themeMain   String?
  themeAccent String?
  themeFont   String?

  podcastRatings PodcastRating[]
  episodeRatings EpisodeRating[]
  logEntries     LogEntry[]
  lists          List[]
  podcastFollows PodcastFollow[]
  favorites      Favorite[]
  comments       Comment[]
  likes          Like[]

  followedBy Follow[] @relation("following")
  following  Follow[] @relation("follower")

  // Notifications this person receives, and the ones their own actions caused
  // for somebody else. Both cascade, so deleting an account removes the
  // notifications it sent as well as the ones it received — otherwise a
  // deleted user would leave "X followed you" rows pointing at nobody.
  notifications       Notification[] @relation("notificationRecipient")
  notificationsCaused Notification[] @relation("notificationActor")
  feedback            Feedback[]

  @@index([username])
}

/**
 * A message sent through the feedback form at /contact.
 *
 * **Stored as well as delivered.** The form's primary delivery is a Discord
 * webhook, because that is somewhere Sasha already is. A row here is the
 * durable copy: the privacy policy tells people to contact us to exercise
 * their rights, so a channel that can silently drop a message is a compliance
 * problem, not just an annoyance.
 *
 * `name` and `email` are optional and are whatever the sender typed — they are
 * not verified and must never be treated as identity. `userId` is the only
 * trustworthy attribution, read from the session server-side, and it is null
 * for anyone not signed in.
 */
model Feedback {
  id      String  @id @default(cuid())
  name    String?
  email   String?
  message String

  // Null for signed-out senders. Cascade rather than SetNull because the
  // privacy policy promises deletion removes personal data, and a feedback
  // message holds whatever its author typed into it.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([createdAt])
}

// The Session model lived here and is gone deliberately (2026-09-07). Sessions
// are Supabase's now: it issues a JWT, stores the refresh token in a cookie, and
// `src/proxy.ts` renews it. Do not reinstate a sessions table — two systems both
// believing they own the session is how people get logged out at random.

// User-follows-user (profile "Followers"/"Following"/"Friends")
model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

// User-follows-podcast (the green Follow/Following button on podcast.html)
model PodcastFollow {
  userId    String
  podcastId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@id([userId, podcastId])
  @@index([podcastId])
}

// Starred/favorited podcasts (profile's "Favorites" tab) — distinct from
// PodcastFollow: following affects your home feed, favoriting is just a
// personal highlight reel shown on your profile.
model Favorite {
  userId    String
  podcastId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@id([userId, podcastId])
  @@index([podcastId])
}

// ── PODCASTS & EPISODES ────────────────────────────────

model Genre {
  id       String    @id @default(cuid())
  name     String    @unique
  podcasts Podcast[]
}

model Person {
  id         String  @id @default(cuid())
  externalId String? @unique // Podcast Index person id, if known
  slug       String  @unique // URL slug for /person/[slug], e.g. "joe-rogan"
  name       String
  avatarUrl  String?
  bio        String? // long-form bio shown on the person profile page

  podcastCredits PodcastPerson[]
  episodeCredits EpisodePerson[]
}

model Podcast {
  id               String   @id @default(cuid())
  externalId       String?  @unique // Podcast Index feed id
  title            String
  author           String
  description      String
  coverUrl         String?
  bannerUrl        String?
  startYear        Int?
  spotifyUrl       String?
  youtubeUrl       String?
  applePodcastsUrl String?
  createdAt        DateTime @default(now())

  genres      Genre[]
  episodes    Episode[]
  people      PodcastPerson[]
  ratings     PodcastRating[]
  logEntries  LogEntry[]
  followers   PodcastFollow[]
  favoritedBy Favorite[]
  listItems   ListItem[]

  @@index([title])
}

model PodcastPerson {
  podcastId String
  personId  String
  role      PersonRole

  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([podcastId, personId])
}

model Episode {
  id               String   @id @default(cuid())
  podcastId        String
  externalId       String?  @unique // Podcast Index episode id
  episodeNumber    Int?
  title            String
  description      String
  coverUrl         String?
  bannerUrl        String?
  audioUrl         String?
  durationSeconds  Int?
  publishedAt      DateTime
  spotifyUrl       String? // falls back to Podcast.spotifyUrl if null
  youtubeUrl       String?
  applePodcastsUrl String?
  createdAt        DateTime @default(now())

  podcast    Podcast         @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  people     EpisodePerson[]
  ratings    EpisodeRating[]
  logEntries LogEntry[]
  listItems  ListItem[]

  @@index([podcastId, publishedAt])
}

model EpisodePerson {
  episodeId String
  personId  String
  role      PersonRole

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([episodeId, personId])
}

// ── RATINGS ─────────────────────────────────────────────
// One current rating tier per (user, target) — this is the mic-icon "Rate" action.
// Split into two models (rather than one Rating with nullable podcastId/episodeId)
// so Prisma/Postgres can enforce true one-per-user-per-target uniqueness.

model PodcastRating {
  id        String     @id @default(cuid())
  userId    String
  podcastId String
  tier      RatingTier
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@unique([userId, podcastId])
  @@index([podcastId])
}

model EpisodeRating {
  id        String     @id @default(cuid())
  userId    String
  episodeId String
  tier      RatingTier
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@index([episodeId])
}

// ── LOG ENTRIES (diary / "Add Log or Review") ──────────
// Decoupled from Rating: the review popup only captures a date + text, no rating.
// Many allowed per (user, target) since relistens/rewatches happen (profile calendar
// shows multiple entries on the same day). Exactly one of podcastId/episodeId is set,
// enforced in the application layer.

model LogEntry {
  id           String      @id @default(cuid())
  userId       String
  podcastId    String?
  episodeId    String?
  listenedDate DateTime
  reviewText   String?
  // The rating AS IT WAS when this was logged. A diary is a time capsule: it
  // must keep showing what you thought then, even after you re-rate. The
  // current opinion lives in PodcastRating/EpisodeRating instead.
  //
  // Nullable because a rating is not required to log an episode.
  //
  // Averages and distribution bars read the CURRENT rating, never this — else
  // someone who relistens and logs three times would count three times.
  tier         RatingTier?
  createdAt    DateTime    @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  podcast  Podcast?  @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  episode  Episode?  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  comments Comment[]
  likes    Like[]

  @@index([userId, listenedDate])
  @@index([podcastId])
  @@index([episodeId])
}

// ── LISTS ───────────────────────────────────────────────

model List {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  isRanked    Boolean  @default(false) // if true, list detail page shows position numbers (e.g. a "top 10" list)
  // The user's single "Next listening" collection, not a list they made.
  // Exactly one per user, created on first add. MUST be excluded wherever real
  // lists are shown — the add-to-list popup, the profile's Your lists tab —
  // or it appears as though the user created it.
  isWatchlist Boolean  @default(false)
  createdAt   DateTime @default(now())

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items    ListItem[]
  comments Comment[]
  likes    Like[]

  @@index([userId])
}

// Comments on a review or a list. Exactly one of logEntryId / listId is set,
// enforced in the application layer — the same pattern LogEntry and ListItem
// already use for their podcast/episode either-or.
//
// A "review" is a LogEntry carrying reviewText; there is no separate table, so
// comments on reviews point at LogEntry.
model Comment {
  id         String   @id @default(cuid())
  userId     String
  logEntryId String?
  listId     String?
  text       String
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  logEntry LogEntry? @relation(fields: [logEntryId], references: [id], onDelete: Cascade)
  list     List?     @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([logEntryId, createdAt])
  @@index([listId, createdAt])
}

model ListItem {
  id        String  @id @default(cuid())
  listId    String
  position  Int
  podcastId String?
  episodeId String?

  list    List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  podcast Podcast? @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  episode Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([listId, position])
  @@index([podcastId])
  @@index([episodeId])
}

// A like on a review or a list. Exactly one of logEntryId / listId is set —
// the same either-or pattern Comment uses, enforced in the application layer.
//
// **Reviews and lists only.** Sasha's call: podcasts and episodes are rated,
// not liked, and he may add likes for them later.
//
// The two composite uniques are what make a like idempotent. They work despite
// the nullable columns because Postgres treats NULLs as distinct: a review like
// has listId NULL, so only (userId, logEntryId) constrains it, and vice versa.
model Like {
  id         String   @id @default(cuid())
  userId     String
  logEntryId String?
  listId     String?
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  logEntry LogEntry? @relation(fields: [logEntryId], references: [id], onDelete: Cascade)
  list     List?     @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([userId, logEntryId])
  @@unique([userId, listId])
  @@index([logEntryId])
  @@index([listId])
}

/**
 * What a notification is about. Stored rather than derived, because the text
 * must not change under the reader: if "X followed you" quietly became "you
 * and X are friends" the moment they followed back, the record of what
 * actually happened would be lost.
 */
enum NotificationType {
  /**
   * Someone followed you, and you do not follow them.
   */
  FOLLOW
  /**
   * Someone followed you back, or you followed them back — you are now friends.
   */
  FRIEND
}

model Notification {
  id        String           @id @default(cuid())
  /**
   * Who sees this.
   */
  userId    String
  /**
   * Who caused it. Never the same as userId — you are not told about yourself.
   */
  actorId   String
  type      NotificationType
  /**
   * Null until opened. The nav badge counts these.
   */
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user  User @relation("notificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User @relation("notificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  // The two queries that exist: the list, newest first, and the unread badge.
  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/// Counters for the durable rate limiter in `src/lib/rateLimit.ts`. Written
/// with raw SQL (one atomic upsert), never through this model — it exists so
/// the table is part of the schema and migrations.
model RateLimit {
  key          String    @id
  count        Int       @default(0)
  windowStart  DateTime  @default(now())
  blockedUntil DateTime?
}
